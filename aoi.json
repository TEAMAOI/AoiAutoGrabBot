{
  "name": "Grabber Userbot",
  "description": "Async Telegram Character Auto-Grabber Userbot powered by Kurigram/Pyrogram.",
  "branch": "main",
  "start_command": "python3 userbot.py",
  "requirements_file": "requirements.txt",
  "buildpacks": ["gcc"],
  "apt_packages": [],
  "recommended_ram": 512,
  "env": {
    "API_ID": {
      "description": "Telegram API ID from https://my.telegram.org",
      "placeholder": "12345678",
      "required": true
    },
    "API_HASH": {
      "description": "Telegram API Hash from https://my.telegram.org",
      "placeholder": "your_api_hash",
      "required": true,
      "secret": true
    },
    "SESSION_STRING": {
      "description": "Pyrogram/Kurigram String Session for your Telegram account",
      "placeholder": "BQA...",
      "required": true,
      "secret": true
    },
    "GRAB_DELAY": {
      "description": "Delay in seconds before sending the grab command",
      "value": "4.0",
      "required": false
    },
    "TAG_BOT_IN_COMMAND": {
      "description": "Send /cmd@BotUsername name (true) or /cmd name (false)",
      "value": "true",
      "required": false
    },
    "LOG_LEVEL": {
      "description": "Logging level (INFO, DEBUG, WARNING)",
      "value": "INFO",
      "required": false
    }
  }
}
